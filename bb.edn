{:deps {outskirtslabs/bb-tasks
        {:git/url "https://github.com/outskirtslabs/bb-tasks"
         :git/sha "9dbc6d77384b51ffde69007e98a0420b3cf6a0a7"}}
 :tasks
 {:requires ([ol.bb-tasks.sync-readme :as sync-readme])

  generate
  {:doc "Regenerate the Tree-sitter parser"
   :task (shell "tree-sitter generate")}

  fmt
  {:doc "Format Rust and grammar sources"
   :task (do
           (shell "cargo fmt --all")
           (shell "prettier --write grammar.js package.json tree-sitter.json"))}

  fmt:check
  {:doc "Check source formatting"
   :task (do
           (shell "cargo fmt --all --check")
           (shell "prettier --check grammar.js package.json tree-sitter.json"))}

  test
  {:doc "Run all Rust tests"
   :task (shell "cargo test --workspace")}

  test:emacs
  {:doc "Run all Emacs ERT tests"
   :task (do
           (shell "mkdir -p target/emacs-tree-sitter")
           (shell "cc -fPIC -shared -Isrc src/parser.c src/scanner.c -o target/emacs-tree-sitter/libtree-sitter-fluent.so")
           (shell "emacs --batch -Q -L editors/emacs --load editors/emacs/test/fluent-ts-mode-test.el --load editors/emacs/test/fluent-ts-flymake-test.el --load editors/emacs/test/flycheck-fluent-test.el --funcall ert-run-tests-batch-and-exit"))}

  lint
  {:doc "Run Clippy with warnings denied"
   :task (shell "cargo clippy --workspace --all-targets -- -D warnings")}

  gen-docs
  {:doc "Generate Antora documentation"
   :task (sync-readme/sync-top-level-docs! {:antora-start-path "doc"})}

  ci
  {:doc "Run the complete quality gate"
   :task (do
           (run 'fmt:check)
           (run 'lint)
           (run 'test)
           (run 'test:emacs))}}}
